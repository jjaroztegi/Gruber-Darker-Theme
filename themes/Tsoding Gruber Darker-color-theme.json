{
  "$schema": "vscode://schemas/color-theme",
  "name": "Tsoding Gruber Darker",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "newOperator": "#ffdd33",
    "stringLiteral": "#73c936",
    "customLiteral": "#95a99f",
    "numberLiteral": "#95a99f",
    "parameter": {
      "foreground": "#f4f4ff"
    },
    "type": {
      "foreground": "#b6b6b6"
    },
    "namespace": {
      "foreground": "#ece9da"
    },
    "macro": {
      "foreground": "#95a99f"
    }
  },
  "tokenColors": [
    {
      "name": "Embedded code and markdown images",
      "scope": ["meta.embedded", "source.groovy.embedded", "string meta.image.inline.markdown"],
      "settings": {
        "foreground": "#f4f4ff"
      }
    },
    {
      "name": "Emphasis (italic)",
      "scope": "emphasis",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strong (bold)",
      "scope": "strong",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Header",
      "scope": "header",
      "settings": {
        "foreground": "#ffdd33"
      }
    },
    {
      "name": "Comments",
      "scope": "comment",
      "settings": {
        "foreground": "#cc8c3c"
      }
    },
    {
      "name": "Language constants",
      "scope": "constant.language",
      "settings": {
        "foreground": "#95A99F"
      }
    },
    {
      "name": "Constants and numbers",
      "scope": [
        "constant",
        "constant.numeric",
        "variable.other.constant",
        "keyword.operator.plus.exponent",
        "keyword.operator.minus.exponent"
      ],
      "settings": {
        "foreground": "#95a99f"
      }
    },
    {
      "name": "Regular expressions",
      "scope": "constant.regexp",
      "settings": {
        "foreground": "#73c936"
      }
    },
    {
      "name": "HTML/XML tags",
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#ffdd33"
      }
    },
    {
      "name": "HTML/XML attributes",
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#f4f4ff"
      }
    },
    {
      "name": "Invalid code",
      "scope": "invalid",
      "settings": {
        "foreground": "#f43841"
      }
    },
    {
      "name": "Markup underline",
      "scope": "markup.underline",
      "settings": {
        "fontStyle": "underline",
        "foreground": "#9e95c7"
      }
    },
    {
      "name": "Markup bold",
      "scope": "markup.bold",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#9e95c7"
      }
    },
    {
      "name": "Markup heading",
      "scope": "markup.heading",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#ffdd33"
      }
    },
    {
      "name": "Markup italic",
      "scope": "markup.italic",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#9e95c7"
      }
    },
    {
      "name": "Markup strikethrough",
      "scope": "markup.strikethrough",
      "settings": {
        "fontStyle": "strikethrough",
        "foreground": "#9e95c7"
      }
    },
    {
      "name": "Markup inserted",
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#73c936"
      }
    },
    {
      "name": "Markup deleted",
      "scope": "markup.deleted",
      "settings": {
        "foreground": "#f43841"
      }
    },
    {
      "name": "Markup changed",
      "scope": "markup.changed",
      "settings": {
        "foreground": "#ffdd33"
      }
    },
    {
      "name": "Markdown quote begin",
      "scope": "punctuation.definition.quote.begin.markdown",
      "settings": {
        "foreground": "#cc8c3c"
      }
    },
    {
      "name": "Markdown list begin",
      "scope": "punctuation.definition.list.begin.markdown",
      "settings": {
        "foreground": "#ffdd33"
      }
    },
    {
      "name": "Markdown inline raw",
      "scope": "markup.inline.raw",
      "settings": {
        "foreground": "#73c936"
      }
    },
    {
      "name": "Brackets of XML/HTML tags",
      "scope": "punctuation.definition.tag",
      "settings": {
        "foreground": "#b6b6b6"
      }
    },
    {
      "name": "Preprocessor directives",
      "scope": ["meta.preprocessor", "entity.name.function.preprocessor"],
      "settings": {
        "foreground": "#ffdd33"
      }
    },
    {
      "name": "Preprocessor strings",
      "scope": "meta.preprocessor.string",
      "settings": {
        "foreground": "#73c936"
      }
    },
    {
      "name": "Preprocessor numbers",
      "scope": "meta.preprocessor.numeric",
      "settings": {
        "foreground": "#95a99f"
      }
    },
    {
      "name": "Diff header",
      "scope": "meta.diff.header",
      "settings": {
        "foreground": "#ffdd33"
      }
    },
    {
      "name": "Storage",
      "scope": "storage",
      "settings": {
        "foreground": "#ffdd33"
      }
    },
    {
      "name": "Storage type",
      "scope": "storage.type",
      "settings": {
        "foreground": "#ffdd33"
      }
    },
    {
      "name": "Storage modifiers",
      "scope": ["storage.modifier", "keyword.operator.noexcept"],
      "settings": {
        "foreground": "#ffdd33"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "meta.embedded.assembly"],
      "settings": {
        "foreground": "#73c936"
      }
    },
    {
      "name": "String tags",
      "scope": "string.tag",
      "settings": {
        "foreground": "#73c936"
      }
    },
    {
      "name": "String values",
      "scope": "string.value",
      "settings": {
        "foreground": "#73c936"
      }
    },
    {
      "name": "Regular expression strings",
      "scope": "string.regexp",
      "settings": {
        "foreground": "#73c936"
      }
    },
    {
      "name": "String interpolation",
      "scope": [
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#ffdd33"
      }
    },
    {
      "name": "Reset JavaScript string interpolation expression",
      "scope": ["meta.template.expression"],
      "settings": {
        "foreground": "#f4f4ff"
      }
    },
    {
      "name": "Keywords",
      "scope": "keyword",
      "settings": {
        "foreground": "#ffdd33"
      }
    },
    {
      "name": "Control keywords",
      "scope": "keyword.control",
      "settings": {
        "foreground": "#ffdd33"
      }
    },
    {
      "name": "Operator keywords",
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#ffdd33"
      }
    },
    {
      "name": "Special operator keywords",
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.cast",
        "keyword.operator.sizeof",
        "keyword.operator.alignof",
        "keyword.operator.typeid",
        "keyword.operator.alignas",
        "keyword.operator.instanceof",
        "keyword.operator.wordlike"
      ],
      "settings": {
        "foreground": "#ffdd33"
      }
    },
    {
      "name": "Unit keywords",
      "scope": "keyword.other.unit",
      "settings": {
        "foreground": "#95a99f"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.other.enummember",
        "variable.other.metavariable.name"
      ],
      "settings": {
        "foreground": "#f4f4ff"
      }
    },
    {
      "name": "Types and annotations",
      "scope": [
        "entity.name.type",
        "entity.other.inherited-class",
        "entity.name.type.primitive",
        "entity.name.type.numeric",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#b6b6b6"
      }
    },
    {
      "name": "Info token",
      "scope": "token.info-token",
      "settings": {
        "foreground": "#6796E6"
      }
    },
    {
      "name": "Warning token",
      "scope": "token.warn-token",
      "settings": {
        "foreground": "#CD9731"
      }
    },
    {
      "name": "Debug token",
      "scope": "token.debug-token",
      "settings": {
        "foreground": "#B267E6"
      }
    },
    {
      "name": "Zig Constants",
      "scope": ["keyword.constant.bool.zig", "keyword.constant.default.zig"],
      "settings": {
        "foreground": "#95a99f"
      }
    },
    {
      "name": "Zig Types",
      "scope": ["keyword.type.zig", "keyword.type.integer.zig", "keyword.type.c.zig"],
      "settings": {
        "foreground": "#b6b6b6"
      }
    },
    {
      "name": "CSS tags",
      "scope": "entity.name.tag.css",
      "settings": {
        "foreground": "#ffdd33"
      }
    },
    {
      "name": "CSS classes, IDs, and pseudo-selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.class.mixin.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.parent-selector.css",
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css",
        "source.css.less entity.other.attribute-name.id",
        "entity.other.attribute-name.scss"
      ],
      "settings": {
        "foreground": "#ffdd33"
      }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.vendored.property-name",
        "support.type.property-name",
        "variable.css",
        "variable.scss",
        "variable.other.less",
        "source.coffee.embedded"
      ],
      "settings": {
        "foreground": "#f4f4ff"
      }
    },
    {
      "name": "Python dictionary keys",
      "scope": "meta.structure.dictionary.key.python",
      "settings": {
        "foreground": "#f4f4ff"
      }
    },
    {
      "name": "Python Logical Operators",
      "scope": "keyword.operator.logical.python",
      "settings": {
        "foreground": "#ffdd33"
      }
    },
    {
      "name": "Python Magic/Decorators",
      "scope": ["support.variable.magic.python", "support.function.magic.python", "meta.function.decorator.python"],
      "settings": {
        "foreground": "#b6b6b6"
      }
    },
    {
      "name": "Java import and package identifiers",
      "scope": ["storage.modifier.import.java", "variable.language.wildcard.java", "storage.modifier.package.java"],
      "settings": {
        "foreground": "#e4e4ef"
      }
    },
    {
      "name": "Java types and annotations",
      "scope": [
        "storage.type.annotation.java",
        "punctuation.definition.annotation.java",
        "storage.type.java",
        "storage.type.generic.java",
        "storage.type.object.array.java"
      ],
      "settings": {
        "foreground": "#b6b6b6"
      }
    },
    {
      "name": "C/C++ Preprocessor",
      "scope": ["entity.name.function.preprocessor.c", "entity.name.function.preprocessor.cpp"],
      "settings": {
        "foreground": "#e4e4ef"
      }
    },
    {
      "name": "C/C++ Arrays and Primitives",
      "scope": ["storage.modifier.array.bracket.square.c", "storage.modifier.array.bracket.square.cpp"],
      "settings": {
        "foreground": "#e4e4ef"
      }
    },
    {
      "name": "C/C++ Primitives",
      "scope": ["storage.type.built-in.primitive.cpp", "storage.type.built-in.primitive.c"],
      "settings": {
        "foreground": "#b6b6b6"
      }
    },
    {
      "name": "JSON Property Names",
      "scope": "support.type.property-name.json",
      "settings": {
        "foreground": "#e4e4ef"
      }
    },
    {
      "name": "YAML Tag Names",
      "scope": "entity.name.tag.yaml",
      "settings": {
        "foreground": "#e4e4ef"
      }
    },
    {
      "name": "HTML Doctype",
      "scope": "meta.tag.metadata.doctype.html",
      "settings": {
        "foreground": "#b6b6b6"
      }
    },
    {
      "name": "Specific Tag Names (HTML/XML/TOML)",
      "scope": ["meta.tag.xml", "entity.name.tag.html", "meta.tag.table.toml"],
      "settings": {
        "foreground": "#ffdd33"
      }
    },
    {
      "name": "PHP embedded sections",
      "scope": ["punctuation.section.embedded.begin.php", "punctuation.section.embedded.end.php"],
      "settings": {
        "foreground": "#ffdd33"
      }
    },
    {
      "name": "Git rebase functions",
      "scope": "support.function.git-rebase",
      "settings": {
        "foreground": "#f4f4ff"
      }
    },
    {
      "name": "Git SHA",
      "scope": "constant.sha.git-rebase",
      "settings": {
        "foreground": "#95a99f"
      }
    },
    {
      "name": "Go types",
      "scope": [
        "storage.type.string.go",
        "storage.type.int.go",
        "storage.type.error.go",
        "storage.type.byte.go",
        "storage.type.numeric.go",
        "storage.type.boolean.go",
        "storage.type.rune.go",
        "storage.type.uintptr.go"
      ],
      "settings": {
        "foreground": "#b6b6b6"
      }
    },
    {
      "name": "Rust Result/Option",
      "scope": ["entity.name.type.result", "entity.name.type.option"],
      "settings": {
        "foreground": "#ffdd33"
      }
    },
    {
      "name": "Rust Metavariable specifier",
      "scope": "variable.other.metavariable.specifier",
      "settings": {
        "foreground": "#ffdd33"
      }
    },
    {
      "name": "Special values (CSS/Rust/Hex)",
      "scope": [
        "support.constant.property-value.css",
        "support.constant.color.w3c-standard-color-name.css",
        "entity.name.type.lifetime",
        "keyword.other.unit.hexadecimal"
      ],
      "settings": {
        "foreground": "#9e95c7"
      }
    },
    {
      "name": "Storage Modifier Array (General but used in Java context)",
      "scope": "storage.modifier.array",
      "settings": {
        "foreground": "#e4e4ef"
      }
    },
    {
      "name": "Julia Types",
      "scope": "support.type.julia",
      "settings": {
        "foreground": "#b6b6b6"
      }
    },
    {
      "name": "Language variables (this, self)",
      "scope": "variable.language",
      "settings": {
        "foreground": "#ffdd33"
      }
    }
  ],
  "colors": {
    "activityBar.background": "#282828",
    "activityBar.foreground": "#ffffff",
    "activityBar.inactiveForeground": "#52494e",
    "activityBarBadge.background": "#ffdd33",
    "activityBarBadge.foreground": "#000000",
    "button.background": "#ffdd33",
    "button.foreground": "#000000",
    "editor.background": "#181818",
    "editor.foreground": "#f4f4ff",
    "editorCursor.foreground": "#ffdd33",
    "editor.findMatchBackground": "#f4f4ff",
    "editor.findMatchForeground": "#0a0a0a",
    "editor.findMatchHighlightBackground": "#8b8989de",
    "editor.findMatchHighlightForeground": "#000000",
    "editor.hoverHighlightBackground": "#63626231",
    "editor.selectionBackground": "#484848",
    "editor.selectionHighlightBackground": "#484848",
    "editor.wordHighlightBackground": "#00000000",
    "editor.wordHighlightStrongBackground": "#282828",
    "editorError.background": "#00000000",
    "editorError.foreground": "#f43841",
    "editorWarning.background": "#00000000",
    "editorWarning.foreground": "#cc8c3c",
    "editorInfo.background": "#00000000",
    "editorGutter.background": "#181818",
    "editorLineNumber.foreground": "#7a7076",
    "editorLineNumber.activeForeground": "#ffdd33",
    "editorLink.activeForeground": "#96a6c8",
    "editorGroupHeader.tabsBackground": "#181818",
    "editorWidget.background": "#282828",
    "editorBracketHighlight.foreground1": "#bfc5bf",
    "editorBracketHighlight.foreground2": "#bfc5bf",
    "editorBracketHighlight.foreground3": "#bfc5bf",
    "editorBracketHighlight.foreground4": "#bfc5bf",
    "editorBracketHighlight.foreground5": "#bfc5bf",
    "editorBracketHighlight.foreground6": "#bfc5bf",
    "editorBracketHighlight.unexpectedBracket.foreground": "#f43841",
    "editorBracketMatch.background": "#52494e",
    "editorBracketMatch.border": "#00000000",
    "editorBracketPairGuide.activeBackground1": "#282828",
    "editorBracketPairGuide.activeBackground2": "#282828",
    "editorBracketPairGuide.activeBackground3": "#282828",
    "editorBracketPairGuide.activeBackground4": "#282828",
    "editorBracketPairGuide.activeBackground5": "#282828",
    "editorBracketPairGuide.activeBackground6": "#282828",
    "editorBracketPairGuide.background1": "#52494e",
    "editorBracketPairGuide.background2": "#52494e",
    "editorBracketPairGuide.background3": "#52494e",
    "editorBracketPairGuide.background4": "#52494e",
    "editorBracketPairGuide.background5": "#52494e",
    "editorBracketPairGuide.background6": "#52494e",
    "sideBar.background": "#181818",
    "statusBar.background": "#282828",
    "statusBar.noFolderBackground": "#282828",
    "statusBar.noFolderForeground": "#ffffff",
    "titleBar.activeBackground": "#282828",
    "titleBar.border": "#282828",
    "textLink.activeForeground": "#96a6c8",
    "textLink.foreground": "#9e95c7"
  }
}
