{
    "name": "gruber-darker-theme",
    "displayName": "Gruber Darker Theme",
    "description": "A VSCode port of the Gruber Darker Emacs theme, based on JoaoAJMatos's adaptation. It delivers a refined dark palette optimized for readability.",
    "version": "1.4.0",
    "publisher": "jjaroztegi",
    "license": "MIT",
    "icon": "img/icon.jpg",
    "galleryBanner": {
        "color": "#181818",
        "theme": "dark"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/jjaroztegi/Gruber-Darker-Theme"
    },
    "bugs": {
        "url": "https://github.com/jjaroztegi/Gruber-Darker-Theme/issues"
    },
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Themes"
    ],
    "keywords": [
        "dark",
        "gruber darker",
        "emacs",
        "minimalist",
        "rexim",
        "tsoding",
        "gruber",
        "colorblind"
    ],
    "contributes": {
        "themes": [
            {
                "label": "Tsoding Gruber Darker",
                "uiTheme": "vs-dark",
                "path": "./themes/Tsoding Gruber Darker-color-theme.json"
            }
        ]
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "ts-node --project scripts/tsconfig.json scripts/generate-theme.ts",
        "validate": "ts-node --project scripts/tsconfig.json scripts/validate-theme.ts",
        "check": "npm run build && npm run validate",
        "generate:assets": "ts-node --project scripts/tsconfig.json scripts/generate-preview-assets.ts",
        "preview": "npm run check && npm run generate:assets",
        "qa:vscode": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/open-vscode-qa.ps1",
        "vscode:prepublish": "npm run check",
        "watch:ts": "tsc --build --watch",
        "package": "vsce package",
        "publish:ovsx": "ovsx publish",
        "publish:vscode": "vsce publish"
    },
    "devDependencies": {
        "@resvg/resvg-js": "^2.6.2",
        "@types/node": "^26.1.0",
        "@vscode/vsce": "^3.9.2",
        "ovsx": "^1.0.2",
        "shiki": "^4.3.1",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3"
    }
}
