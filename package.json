{
    "name": "gruber-darker-theme",
    "displayName": "Gruber Darker Theme",
    "description": "A VSCode port of the Gruber Darker Emacs theme, based on JoaoAJMatos's adaptation. It delivers a refined dark palette optimized for readability.",
    "version": "1.3.0",
    "publisher": "jjaroztegi",
    "license": "MIT",
    "icon": "img/icon.jpg",
    "galleryBanner": {
        "color": "#181818",
        "theme": "dark"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/jjaroztegi/Gruber-Darker-Theme"
    },
    "bugs": {
        "url": "https://github.com/jjaroztegi/Gruber-Darker-Theme/issues"
    },
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Themes"
    ],
    "keywords": [
        "dark",
        "gruber darker",
        "emacs",
        "minimalist",
        "rexim",
        "tsoding",
        "gruber",
        "colorblind"
    ],
    "contributes": {
        "themes": [
            {
                "label": "Tsoding Gruber Darker",
                "uiTheme": "vs-dark",
                "path": "./themes/Tsoding Gruber Darker-color-theme.json"
            }
        ]
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "ts-node --project scripts/tsconfig.json scripts/generate-theme.ts",
        "watch:ts": "tsc --build --watch",
        "package": "npx vsce package",
        "publish:ovsx": "npx ovsx publish",
        "publish:vscode": "npx vsce publish"
    },
    "devDependencies": {
        "@types/node": "^16.11.33",
        "ts-node": "^10.7.0",
        "typescript": "^4.6.4"
    }
}
